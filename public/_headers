# Netlify response headers, copied into the static export.
# Everything under /_next/static has a content hash in its filename, so a changed file
# gets a new URL and these can be cached for good.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Design assets keep stable names, so they revalidate after a day.
/figma/*
  Cache-Control: public, max-age=86400, must-revalidate
